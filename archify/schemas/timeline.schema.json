{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tencentmalos/archify/schemas/timeline.schema.json",
  "title": "Measured concurrency timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "evidence_kind",
    "clock",
    "window",
    "sources",
    "lanes",
    "intervals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "timeline"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "color_palette": {
          "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/colorPalette"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "locale": {
          "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/locale"
        },
        "quality_profile": {
          "enum": [
            "standard",
            "showcase"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "interval_color": {
          "enum": [
            "role",
            "label"
          ]
        }
      }
    },
    "evidence_kind": {
      "enum": [
        "measured",
        "synthetic"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "origin",
        "gpu_alignment"
      ],
      "properties": {
        "id": {
          "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
        },
        "unit": {
          "const": "ms"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "gpu_alignment": {
          "enum": [
            "not_applicable",
            "calibrated",
            "uncalibrated"
          ]
        },
        "calibration_source": {
          "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reference",
          "complete"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "complete": {
            "const": true
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "kind": {
            "enum": [
              "cpu",
              "gpu",
              "other"
            ]
          }
        }
      }
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "label",
          "start",
          "end",
          "role",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "lane": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          },
          "role": {
            "enum": [
              "work",
              "detail",
              "wait"
            ]
          },
          "source": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "parent": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "frame": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "display_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "time",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          },
          "kind": {
            "enum": [
              "frame",
              "event"
            ]
          },
          "source": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "label",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "from": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "lanes"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "https://github.com/tt-a1i/archify/schemas/common.schema.json#/$defs/id"
            }
          }
        }
      }
    }
  }
}
